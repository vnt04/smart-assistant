###############################################
# Production domain
###############################################
APP_DOMAIN=assistant.example.com
CERTBOT_EMAIL=admin@example.com
VITE_APP_NAME=Personal Assistant
TZ=Asia/Ho_Chi_Minh

###############################################
# Backend
###############################################
NODE_ENV=production
BACKEND_PORT=3000
BACKEND_PUBLIC_URL=https://assistant.example.com

JWT_ACCESS_SECRET=replace-with-random-64-plus-chars-access-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=replace-with-random-64-plus-chars-refresh-secret
JWT_REFRESH_TTL=30d

# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace-with-64-hex-chars

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://assistant.example.com/api/auth/google/callback

UPLOAD_DIR=/data/uploads
UPLOAD_MAX_MB=20

###############################################
# MySQL
###############################################
MYSQL_DATABASE=assistant
MYSQL_USER=assistant
MYSQL_PASSWORD=replace-with-strong-mysql-password
MYSQL_ROOT_PASSWORD=replace-with-strong-root-password

###############################################
# Redis
###############################################
REDIS_PASSWORD=

###############################################
# Backup
###############################################
BACKUP_RETENTION_DAYS=14
