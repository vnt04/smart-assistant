###############################################
# Core
###############################################
NODE_ENV=development
TZ=Asia/Ho_Chi_Minh

###############################################
# Backend
###############################################
BACKEND_PORT=3000
BACKEND_PUBLIC_URL=http://localhost:3000

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-32-chars-min
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-32-chars-min
JWT_REFRESH_TTL=30d

# AES-256-GCM key (32 bytes, hex encoded = 64 chars). Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace-with-64-hex-chars

# Google OAuth (optional in dev)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Uploads
UPLOAD_DIR=/data/uploads
UPLOAD_MAX_MB=20

###############################################
# Database (MySQL 8)
###############################################
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=assistant
MYSQL_USER=assistant
MYSQL_PASSWORD=assistant_dev_pw
MYSQL_ROOT_PASSWORD=root_dev_pw

###############################################
# Redis (BullMQ + cache)
###############################################
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

###############################################
# Frontend (Vite)
###############################################
VITE_API_BASE_URL=/api
VITE_APP_NAME=Personal Assistant
