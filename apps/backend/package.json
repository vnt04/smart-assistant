{
  "name": "@assistant/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Personal Assistant — NestJS API",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 0",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "typeorm:dev": "tsx ./node_modules/typeorm/cli.js -d src/database/data-source.ts",
    "typeorm:prod": "node ./node_modules/typeorm/cli.js -d dist/database/data-source.js",
    "migration:generate": "pnpm typeorm:dev migration:generate",
    "migration:run": "pnpm typeorm:prod migration:run",
    "migration:run:dev": "pnpm typeorm:dev migration:run",
    "migration:revert": "pnpm typeorm:prod migration:revert"
  },
  "dependencies": {
    "@assistant/shared": "workspace:*",
    "@nestjs/common": "10.4.6",
    "@nestjs/config": "3.2.3",
    "@nestjs/core": "10.4.6",
    "@nestjs/jwt": "10.2.0",
    "@nestjs/passport": "10.0.3",
    "@nestjs/platform-express": "10.4.6",
    "@nestjs/typeorm": "10.0.2",
    "bcrypt": "5.1.1",
    "bullmq": "5.21.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "dotenv": "16.4.5",
    "ioredis": "5.4.1",
    "mysql2": "3.11.3",
    "nestjs-pino": "4.1.0",
    "nestjs-zod": "4.0.1",
    "passport": "0.7.0",
    "passport-google-oauth20": "2.0.0",
    "passport-jwt": "4.0.1",
    "pino": "9.5.0",
    "pino-http": "10.3.0",
    "pino-pretty": "11.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "typeorm": "0.3.20",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "10.4.7",
    "@nestjs/schematics": "10.2.3",
    "@nestjs/testing": "10.4.6",
    "@types/bcrypt": "5.0.2",
    "@types/express": "5.0.0",
    "@types/jest": "29.5.13",
    "@types/multer": "1.4.12",
    "@types/node": "20.16.11",
    "@types/passport-google-oauth20": "2.0.16",
    "@types/passport-jwt": "4.0.1",
    "@types/supertest": "6.0.2",
    "jest": "29.7.0",
    "supertest": "7.0.0",
    "ts-jest": "29.2.5",
    "ts-loader": "9.5.1",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "tsx": "4.19.2",
    "typescript": "5.5.4"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": ["**/*.(t|j)s"],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
